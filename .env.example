GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
OPEN_ROUTER_API_KEY=your_openrouter_api_key
# Bedrock uses the standard AWS credential chain. Use either a Bedrock API key,
# access keys, an AWS profile locally, or an IAM role in AWS. Never commit real values.
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_REGION=ap-south-1

# Deterministic routes use no API; these providers handle ambiguous turns and RAG generation.
# Supported values: bedrock, groq, openrouter.
INTERPRETER_PROVIDER=bedrock
INTERPRETER_MODEL=openai.gpt-oss-120b-1:0
RAG_GENERATION_PROVIDER=bedrock
RAG_GENERATION_MODEL=openai.gpt-oss-120b-1:0
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Timmins WhatsApp Assistant
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=july_2026_intake_followup
WHATSAPP_TEMPLATE_LANGUAGE=en_US

GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Single workbook containing one tab per course
TIMMINS_LEADS_WORKBOOK=Timmins Leads
TIMMINS_EXTRA_LEADS_WORKBOOK=
ENABLE_GOOGLE_SHEETS=false

# Legacy single-sheet webhook sync (still used if ENABLE_GOOGLE_SHEETS=true)
GOOGLE_SHEET_NAME=Timmins Leads
GOOGLE_WORKSHEET_NAME=Software Testing

WHATSAPP_DB_PATH=whatsapp_bot.db
# Production: set DATABASE_URL to managed PostgreSQL. When present, it takes precedence over SQLite.
DATABASE_URL=
BOT_SAFE_MODE=true
REPLY_DELAY_SECONDS=2
LOG_LEVEL=INFO
OUTREACH_MESSAGE=Hi {full_name}, we help professionals improve their software testing skills. Would you be open to a quick chat?

# --- Admin dashboard -------------------------------------------------------
# Where the bot reads its course/knowledge/policy content from.
#   files (default) = the repo's courses/ and knowledge/ directories
#   db              = the content tables, which the dashboard edits
# Dashboard editing is refused unless this is `db`, so an edit can never be
# written somewhere nothing reads. Run scripts/import_content_to_db.py before
# switching, and remove this variable to fall straight back to files.
CONTENT_SOURCE=files

# Seeds the admin password on first boot only; afterwards it is stored hashed
# in the database and changed from the dashboard. Use a long random value.
ADMIN_PASSWORD=

# Keep the vector index in Postgres so the app stays stateless and uploaded
# documents survive a redeploy. Required for uploads to reach the bot when the
# dashboard runs as a separate service — without it, ingestion silently writes
# to a local file the bot never reads.
RAG_STORE=postgres

# OCR fallback for scanned uploads (needs tesseract-ocr + poppler-utils; see
# nixpacks.toml). Cap bounds the work one document can cause; 0 disables OCR.
OCR_PAGE_CAP=40
OCR_DPI=200

# Leads created before this timestamp are never auto-contacted — it protects
# the leads that existed before the bot went live. ISO 8601, e.g. 2026-08-01T00:00:00+08:00
LEAD_SYNC_CONTACT_CUTOFF=
